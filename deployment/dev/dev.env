# PHOTO
EXTENSION_PHOTO_EXTS=.jpg,.jpeg,.png,.gif,.bmp,.tiff,.tif,.svg,.gif,.webp,.heic,.heif,.avif,.ico,.psd,.ai,.indd,.emf,.wmf
EXTENSION_PHOTO_MIME_TYPES=image/*

# VIDEO
EXTENSION_VIDEO_EXTS=.mp4,.avi,.mov,.wmv,.flv,.mkv,.webm,.m3u8,.mpeg,.3gp,.m4v,.ts,.vob,.rm,.rmvb,.f4v
EXTENSION_VIDEO_MIME_TYPES=video/*

# AUDIO
EXTENSION_AUDIO_EXTS=.mp3,.wav,.aac,.flac,.ogg,.m4a,.amr,.aiff,.opus
EXTENSION_AUDIO_MIME_TYPES=audio/*

# DOCUMENT
EXTENSION_DOCUMENT_EXTS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.odt,.rtf,.pages,.epub,.md,.xml,.json,.html,.htm,.pptm,.docm,.ods,.xltx,.xltm,.dotx,.dotm
EXTENSION_DOCUMENT_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.text,application/rtf,application/epub+zip,application/vnd.ms-powerpoint,application/vnd.ms-excel,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation,application/xml,application/json,text/plain,text/csv,text/markdown,text/html,text/javascript

# COMPRESS
EXTENSION_COMPRESS_EXTS=.zip,.rar,.7z,.tar,.gz,.z,.bz2,.z,.tar.bz2,.tar.xz,.tar.zst,.tar.gz,.tgz,.zst,.lz4,.lzo,.rar5,.cab,.arj,.ace,.apk
EXTENSION_COMPRESS_MIME_TYPES=application/zip,application/x-rar-compressed,application/x-7z-compressed,application/x-tar,application/gzip,application/x-bzip2,application/x-zstd,application/x-lz4,application/x-lzo,application/x-rar,application/vnd.ms-cab-compressed,application/x-arj,application/x-ace,application/vnd.android.package-archive

# OTHER
EXTENSION_OTHER_EXTS=
EXTENSION_OTHER_MIME_TYPES=

